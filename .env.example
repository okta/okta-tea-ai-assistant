# =============================================================================
# Okta TEA Security Assistant — environment configuration
#
# Copy this file to .env and fill in your values.
# Start in dev mode:   npm run dev
# Start in prod mode:  npm run prod
# =============================================================================

# -----------------------------------------------------------------------------
# Anthropic API key
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# OpenAI API key
# -----------------------------------------------------------------------------
OPENAI_API_KEY=123456

# -----------------------------------------------------------------------------
# Okta credentials — development tenant
# Used when the app is started with:  npm run dev
# -----------------------------------------------------------------------------
OKTA_TEA_DEV_DOMAIN=dev-123456.okta.com
OKTA_TEA_DEV_CLIENT_ID=0oaXXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# Okta credentials — production tenant
# Used when the app is started with:  npm run prod
# Resolution mode (Terraform / Admin Console / Auto-fix) is disabled in the UI
# when running in production mode.
# -----------------------------------------------------------------------------
OKTA_TEA_PROD_DOMAIN=acme.okta.com
OKTA_TEA_PROD_CLIENT_ID=0oaXXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# Optional overrides
# -----------------------------------------------------------------------------

# Path to the MCP server entry point
# Default: ./mcp/src/index.js
# MCP_SERVER_PATH=/absolute/path/to/mcp/src/index.js

# Web UI port (default: 3000)
# PORT=3000
# DEBUG=false
